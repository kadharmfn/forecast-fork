# Google Maps Platform key — needs both "Geocoding API" and "Places API" enabled
# (console.cloud.google.com → APIs & Services → Library)
GOOGLE_MAPS_API_KEY=

# AWS Bedrock (reasoning LLM — swap in whatever Claude model you have enabled)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6-v1:0

# Auth option A (simplest): a Bedrock API key generated from the Bedrock console
# (Bedrock → API keys → Generate API key). The SDK picks this up automatically — leave
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY blank if you use this.
AWS_BEARER_TOKEN_BEDROCK=

# Auth option B: a full IAM access key pair instead (needs bedrock:InvokeModel permission).
# Only fill these in if you're not using AWS_BEARER_TOKEN_BEDROCK above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
